# Environment file for the systemd unit. Copy to /opt/vault-mcp-server/.env,
# then: chmod 600 /opt/vault-mcp-server/.env  (it holds the master password).
# Format: one KEY=VALUE per line, NO quotes, NO spaces around '='.

# Encrypted store root (must match ReadWritePaths in the unit file)
VAULT_DIR=/var/lib/vault-mcp/vault

# Linux has no DPAPI — always use PBKDF2
VAULT_FORCE_PBKDF2=1

# The server can decrypt every user's vault with this. Treat it like a root key.
VAULT_MASTER_PASSWORD=change-me-to-a-long-random-string

# Path to the provisioned config (users + tokens)
VAULT_CONFIG=/opt/vault-mcp-server/config.yaml

# Set 1 only behind TLS (the nginx proxy above)
VAULT_COOKIE_SECURE=1
