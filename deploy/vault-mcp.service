[Unit]
Description=Vault MCP Server (credential vault + remote MCP)
Documentation=https://github.com/LianghaiLi-root/vault-mcp-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vault
Group=vault
WorkingDirectory=/opt/vault-mcp-server

# EnvironmentFile: one KEY=VALUE per line, NO quotes. chmod 600, owned by vault.
EnvironmentFile=/opt/vault-mcp-server/.env

ExecStart=/opt/vault-mcp-server/.venv/bin/python -m uvicorn vault_mcp.server:app --host 127.0.0.1 --port 8080
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

# --- security hardening ---
NoNewPrivileges=true
# ProtectSystem=full makes /usr, /boot and /etc read-only. We deliberately do NOT
# use "strict" here: strict remounts the WHOLE filesystem read-only, and a
# ReadWritePaths entry pointing at a file inside an already read-only tree is
# silently ignored by systemd (verified on systemd 255) — which made every admin
# config write fail with "[Errno 30] Read-only file system".
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
# Writable: vault data + operator config (the admin API rewrites config.yaml).
ReadWritePaths=/var/lib/vault-mcp /opt/vault-mcp-server
# ...but pin the application code itself read-only, so a compromised process
# cannot rewrite its own source.
ReadOnlyPaths=/opt/vault-mcp-server/vault_mcp

[Install]
WantedBy=multi-user.target
